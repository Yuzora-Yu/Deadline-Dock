{
  "name": "deadline-dock",
  "private": true,
  "version": "0.1.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "tsc -p tsconfig.web.json && vite build --config vite.web.config.ts && node scripts/build-web-offline.mjs",
    "check:web": "tsc -p tsconfig.web.json --noEmit",
    "test:web-ui": "node scripts/test-web-ui.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
